# Quartus settings for the DE1-SoC (Cyclone V SoC 5CSEMA5F31C6).
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY de1soc_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1

# ---- sources (paths are relative to this folder) ----
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/de1soc_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/requantize.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/mac_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/conv_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/avgpool_fc.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/tilecnn_top.sv
set_global_assignment -name SDC_FILE constraints/enset_exw.sdc

# ---- pins: VERIFY every pin against the DE1-SoC User Manual / Terasic System Builder before programming ----
set_location_assignment PIN_AF14 -to CLOCK_50
set_location_assignment PIN_AA14 -to KEY0_N
set_location_assignment PIN_V16  -to LED0
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY0_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED0
